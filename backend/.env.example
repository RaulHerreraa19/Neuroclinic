NODE_ENV=development
PORT=4000

# 5433, no 5432: si ya tienes un Postgres local corriendo en 5432, el docker-compose.yml
# de este repo publica el suyo en 5433 para no chocar con él.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=neuroclinic
DB_USER=postgres
DB_PASSWORD=postgres

# false para Postgres local (Docker); true para Neon u otro proveedor que exija SSL,
# incluso en desarrollo (NODE_ENV ya no controla esto).
DB_SSL=false

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 32-byte key in hex (64 hex chars) used to encrypt sensitive clinical_records fields.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLINICAL_ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

CORS_ORIGIN=http://localhost:5173

# SMTP para enviar al paciente su contraseña temporal al registrarse (ver services/email.js).
# Si SMTP_HOST se deja vacío, en desarrollo el correo no se envía de verdad: la contraseña
# temporal solo se imprime en la consola del backend para poder probar el flujo.
SMTP_HOST=
# En Render usar 2525: bloquea la salida por 25/465/587 (Brevo acepta 2525).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NeuroClinic <no-reply@neuroclinic.test>

# SMS por Brevo para recuperar contraseña (ver services/sms.js). BREVO_API_KEY es la API key
# (empieza con xkeysib-), NO la SMTP key: Brevo → SMTP & API → API Keys. Requiere créditos de SMS.
# Si se deja vacía, el código de recuperación solo se imprime en la consola del backend.
# SMS_SENDER: nombre del remitente, máx. 11 caracteres alfanuméricos.
BREVO_API_KEY=
SMS_SENDER=NeuroClinic

# Datos que aparecen en los correos de confirmación de cita (todos opcionales).
# APP_URL: URL pública del frontend para los enlaces "Iniciar sesión" / "Ver mis citas";
# si se deja vacío se usa el primer origen de CORS_ORIGIN.
APP_URL=
CLINIC_ADDRESS=
CLINIC_PHONE=
